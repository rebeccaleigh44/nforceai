---
import Arcs from './Arcs.astro';
interface Props { title?: string; body?: string; tone?: 'day' | 'night'; primary?: { label: string; href: string } }
const { title = 'See an agent work on your own leads.', body = 'Thirty minutes. We set up an agent on your use case and show you the numbers it reports.', tone = 'day', primary = { label: 'Book a demo', href: '/demo' } } = Astro.props;
---
<section class:list={['section grain cta', tone]}>
  <Arcs class="cta-arcs" tone={tone === 'day' ? 'dark' : 'light'} rings={8} />
  <div class="wrap cta-in">
    <h2>{title}</h2>
    <div class="cta-r">
      <p class="lede">{body}</p>
      <div class="cta-b"><a class="btn btn-primary" href={primary.href}>{primary.label}</a><a class="btn btn-ghost" href="/pricing">See pricing</a></div>
    </div>
  </div>
</section>
<style>
  :global(.cta-arcs) { position: absolute; width: 1100px; left: -420px; top: 50%; transform: translateY(-50%); z-index: -1; opacity: .55; }
  .cta-in { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: end; }
  .cta-in h2 { font-size: var(--fs-3xl); max-width: 14ch; }
  .cta-r { display: grid; gap: 1.5rem; }
  .night .lede { color: var(--c-tint); }
  .cta-b { display: flex; gap: .75rem; flex-wrap: wrap; }
  @media (max-width: 860px) { .cta-in { grid-template-columns: 1fr; } }
</style>
