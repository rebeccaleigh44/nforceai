---
/** Copy on one side, a UI card (slot) on the other. Rules instead of cards for the bullets. */
interface Props {
  label: string; tag?: string; title: string; body: string;
  bullets?: { t: string; d: string }[]; reverse?: boolean; level?: 'h2' | 'h3';
}
const { label, tag, title, body, bullets = [], reverse = false, level = 'h2' } = Astro.props;
const H = level;
---
<div class:list={['fr', { reverse }]}>
  <div class="fr-copy">
    <p class="label eyebrow">{label}{tag && <span class="fr-tag">{tag}</span>}</p>
    <H class:list={['fr-h', { sub: level === 'h3' }]}>{title}</H>
    <p class="fr-body">{body}</p>
    {bullets.length > 0 && (
      <dl class="fr-list">
        {bullets.map((b) => <div><dt>{b.t}</dt><dd>{b.d}</dd></div>)}
      </dl>
    )}
  </div>
  <div class="fr-card"><slot /></div>
</div>
<style>
  .fr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .fr.reverse .fr-copy { order: 2; }
  .fr-h { font-size: var(--fs-2xl); max-width: 18ch; }
  .fr-h.sub { font-size: var(--fs-xl); max-width: 22ch; }
  .fr-body { margin-top: 1.1rem; max-width: 48ch; }
  :global(.night) .fr-body { color: var(--c-tint); }
  .fr-tag { margin-left: .75rem; padding: .1rem .55rem; border-radius: 99px; border: 1px solid currentColor; letter-spacing: .04em; text-transform: none; opacity: .85; }
  .fr-list { margin: 1.75rem 0 0; display: grid; }
  .fr-list div { padding: .9rem 0; border-top: 1px solid rgb(16 0 140 / .14); display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; }
  :global(.night) .fr-list div { border-top-color: rgb(255 255 255 / .14); }
  .fr-list dt { color: var(--c-heading); font-weight: 600; }
  :global(.night) .fr-list dt { color: var(--c-white); }
  .fr-list dd { margin: 0; }
  :global(.night) .fr-list dd { color: var(--c-tint); }
  .fr-card { width: 100%; max-width: 540px; justify-self: center; }
  @media (max-width: 900px) {
    .fr { grid-template-columns: 1fr; }
    .fr.reverse .fr-copy { order: 0; }
    .fr-list div { grid-template-columns: 1fr; gap: .2rem; }
  }
</style>
