---
/** Proof numbers at display size. Plain numeric values count up once on view. */
interface Props { stats: { value: string; label: string }[]; size?: 'lg' | 'xl' }
const { stats, size = 'lg' } = Astro.props;
const parse = (v: string) => { const m = v.match(/^(\D*)(\d[\d,]*)(\D*)$/); return m ? { pre: m[1], n: Number(m[2].replace(/,/g, '')), post: m[3] } : null; };
---
<ul class:list={['sg', size]}>
  {stats.map((s) => {
    const p = parse(s.value);
    return (
      <li {...(p && p.n > 1 ? { 'data-count': p.n } : {})}>
        <p class="sg-n num" aria-hidden="true">{p && p.n > 1 ? <>{p.pre}<span class="n">{p.n}</span>{p.post}</> : s.value}</p>
        <p class="sg-l"><span class="sr-only">{s.value} </span>{s.label}</p>
      </li>
    );
  })}
</ul>
<style>
  .sg { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem 2.5rem; }
  .sg-n { font-size: var(--fs-3xl); line-height: 1; color: var(--c-heading); white-space: nowrap; }
  .xl .sg-n { font-size: clamp(3rem, 1.5rem + 5vw, 6rem); color: var(--c-primary); }
  :global(.night) .sg-n { color: var(--c-white); }
  .sg-l { margin-top: .7rem; color: var(--c-heading); font-weight: 400; max-width: 22ch; }
  :global(.night) .sg-l { color: var(--c-tint); }
  @media (max-width: 900px) {
    .sg { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .sg { grid-template-columns: 1fr; }
  }
</style>
