---
/**
 * Product UI recomposed in HTML (sample data). One frosted card per product
 * moment; the `kind` picks the layout. Static: no JS. Always a "night" panel,
 * so live UI glows on both night and daylight sections.
 */
type Item = Record<string, any>;
interface Props {
  title: string;
  kind: 'kv' | 'rows' | 'bars' | 'chips' | 'chat' | 'versions' | 'tests' | 'stages' | 'flow' | 'table';
  items: Item[];
  note?: string;
  banner?: string;
  cols?: string[];
  class?: string;
}
const { title, kind, items, note, banner, cols, class: cls = '' } = Astro.props;
// Keep each card to the point: four rows at most.
const rows = items.slice(0, 4);
---
<figure class:list={['ui', `ui--${kind}`, cls]}>
  <figcaption class="ui-h">
    <span class="ui-t">{title}</span>
    <span class="ui-s">Sample</span>
  </figcaption>

  {banner && <p class="ui-banner">{banner}</p>}

  {kind === 'kv' && (
    <dl class="ui-kv">
      {rows.map((i) => (
        <div><dt>{i.k}</dt><dd>{i.v}</dd></div>
      ))}
    </dl>
  )}

  {kind === 'rows' && (
    <ul class="ui-rows">
      {rows.map((i) => (
        <li>
          <span class="ui-rn">{i.name}<small>{i.meta}</small></span>
          <span class={`ui-rs ${i.status === 'alert' ? 'is-alert' : ''}`}>{i.label}</span>
        </li>
      ))}
    </ul>
  )}

  {kind === 'bars' && (
    <ul class="ui-bars">
      {rows.map((i) => (
        <li>
          <span class="ui-bl">{i.name}</span>
          <span class="ui-bt"><i style={`width:${Math.round(i.w * 100)}%`} /></span>
          <span class="ui-bv num">{i.value}</span>
        </li>
      ))}
    </ul>
  )}

  {kind === 'chips' && (
    <ul class="ui-chips">
      {rows.map((i) => (
        <li>{i.name}<span class="num">{i.count}</span></li>
      ))}
    </ul>
  )}

  {kind === 'chat' && (
    <ol class="ui-chat">
      {rows.map((i) => (
        <li class={`ui-m ${i.who}`}>
          <span class="ui-who">{i.who === 'contact' ? 'Customer' : i.who === 'agent' ? 'Agent' : 'You'}</span>
          <span class="ui-txt">{i.text}</span>
        </li>
      ))}
    </ol>
  )}

  {kind === 'versions' && (
    <ul class="ui-rows">
      {rows.map((i) => (
        <li>
          <span class="ui-rn">{i.name}<small class="num">{i.v}</small></span>
          <span class={`ui-rs ${i.state === 'live' ? 'is-live' : ''}`}>{i.state === 'live' ? 'Live' : i.state === 'draft' ? 'Draft' : 'Archived'}</span>
        </li>
      ))}
    </ul>
  )}

  {kind === 'tests' && (
    <ul class="ui-rows">
      {rows.map((i) => (
        <li>
          <span class="ui-rn">{i.name}</span>
          <span class={`ui-rs ${i.result === 'pass' ? '' : 'is-alert'}`}>{i.result === 'pass' ? 'Pass' : 'Fail'}</span>
        </li>
      ))}
    </ul>
  )}

  {kind === 'stages' && (
    <ol class="ui-stages">
      {rows.map((i) => (
        <li>
          <span class="ui-sb" style={`width:${Math.max(18, Math.round(i.w * 100))}%`}>{i.name}</span>
          <span class="num">{i.count}</span>
        </li>
      ))}
    </ol>
  )}

  {kind === 'flow' && (
    <ol class="ui-flow">
      {rows.map((i, n) => (
        <li>
          <span class="ui-node"><b>{i.name}</b><small>{i.meta}</small></span>
          {n < rows.length - 1 && <span class="ui-arrow" aria-hidden="true" />}
        </li>
      ))}
    </ol>
  )}

  {kind === 'table' && (
    <table class="ui-table">
      <thead><tr>{(cols ?? []).map((c) => <th scope="col">{c}</th>)}</tr></thead>
      <tbody>{rows.map((i) => <tr><th scope="row">{i.name}</th><td class="num">{i.a}</td><td class="num">{i.b}</td><td class="num">{i.c}</td></tr>)}</tbody>
    </table>
  )}

  {note && <p class="ui-note">{note}</p>}
</figure>

<style>
  .ui {
    margin: 0; padding: 1.25rem 1.35rem 1.35rem; border-radius: var(--r-lg); color: var(--c-tint); font-size: var(--fs-sm);
    background: var(--c-night1);
    border: 1px solid var(--line-night);
    box-shadow: 0 40px 80px -40px rgb(7 6 31 / .7);
  }
  :global(.night) .ui { background: var(--panel-night); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  .ui-h { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1rem; }
  .ui-t { color: var(--c-white); font-weight: 500; }
  .ui-s { font-size: var(--fs-xs); color: var(--c-lilac); white-space: nowrap; }
  .ui-banner { margin: 0 0 1rem; padding: .5rem .75rem; border-radius: var(--r-sm); background: var(--c-warn); color: var(--c-ink); font-size: var(--fs-xs); font-weight: 400; }
  .ui-note { margin-top: 1rem; font-size: var(--fs-xs); color: var(--c-lilac); }

  .ui-kv { margin: 0; display: grid; gap: .75rem; }
  .ui-kv div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; }
  .ui-kv dt { color: var(--c-lilac); }
  .ui-kv dd { margin: 0; color: var(--c-white); }

  .ui-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .ui-rows li { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 1rem; }
  .ui-rn { display: grid; gap: .1rem; color: var(--c-white); font-weight: 400; min-width: 0; }
  .ui-rn small { color: var(--c-lilac); font-size: var(--fs-xs); font-weight: 300; }
  .ui-rs { color: var(--c-lilac); white-space: nowrap; }
  .ui-rs.is-live { color: var(--c-white); font-weight: 500; }
  .ui-rs.is-alert { color: #FF8A8A; font-weight: 500; }

  .ui-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; }
  .ui-bars li { display: grid; grid-template-columns: 7.5rem 1fr 3.5rem; align-items: center; gap: .75rem; }
  .ui-bl { color: var(--c-lilac); }
  .ui-bt { height: 6px; border-radius: var(--r-sm); background: var(--panel-night); overflow: hidden; }
  .ui-bt i { display: block; height: 100%; background: var(--c-primary); }
  .ui-bv { text-align: right; color: var(--c-white); }

  .ui-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .ui-chips li { display: inline-flex; align-items: center; gap: .5rem; padding: .4rem .75rem; border-radius: var(--r-sm); background: var(--panel-night); color: var(--c-white); }
  .ui-chips .num { color: var(--c-lilac); font-weight: 400; }

  .ui-chat { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .ui-m { display: grid; gap: .2rem; max-width: 86%; }
  .ui-m.agent, .ui-m.you { justify-self: end; }
  .ui-who { font-size: var(--fs-xs); color: var(--c-lilac); }
  .ui-m.agent .ui-who, .ui-m.you .ui-who { text-align: right; }
  .ui-txt { padding: .55rem .8rem; border-radius: var(--r-md); line-height: 1.4; }
  .ui-m.contact .ui-txt { background: var(--panel-night); color: var(--c-white); }
  .ui-m.agent .ui-txt { background: var(--c-primary); color: var(--c-white); }
  .ui-m.you .ui-txt { background: var(--c-white); color: var(--c-heading); font-weight: 400; }

  .ui-stages { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .ui-stages li { display: flex; align-items: center; gap: .75rem; }
  .ui-sb { padding: .5rem .75rem; border-radius: var(--r-sm); background: var(--c-primary); color: var(--c-white); white-space: nowrap; }
  .ui-stages .num { color: var(--c-white); }

  .ui-flow { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
  .ui-flow li { display: flex; align-items: center; gap: .5rem; }
  .ui-node { display: grid; padding: .55rem .8rem; border-radius: var(--r-sm); background: var(--panel-night); }
  .ui-node b { color: var(--c-white); font-weight: 500; }
  .ui-node small { color: var(--c-lilac); font-size: var(--fs-xs); }
  .ui-arrow { width: 16px; height: 1px; background: var(--c-lilac); position: relative; }
  .ui-arrow::after { content: ""; position: absolute; right: -1px; top: -3px; border: 3.5px solid transparent; border-left-color: var(--c-lilac); border-right: 0; }

  .ui-table { width: 100%; border-collapse: collapse; }
  .ui-table th, .ui-table td { padding: .45rem .4rem; text-align: right; font-weight: 300; }
  .ui-table thead th { font-size: var(--fs-xs); color: var(--c-lilac); padding-bottom: .65rem; }
  .ui-table th:first-child { text-align: left; }
  .ui-table tbody th { color: var(--c-white); font-weight: 400; }
  .ui-table td { color: var(--c-white); }
</style>
