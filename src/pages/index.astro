---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroField from '../components/HeroField.astro';
import Arcs from '../components/Arcs.astro';
import HeroSignal from '../components/HeroSignal.astro';
import OrbitLoop from '../components/islands/OrbitLoop';
import SpeedRace from '../components/islands/SpeedRace';
import RoiEstimator from '../components/islands/RoiEstimator';

const stops = (await getCollection('platform')).map((e) => ({ id: e.id, ...e.data })).sort((a, b) => a.order - b.order);
const industries = (await getCollection('industries')).map((e) => ({ id: e.id, ...e.data }));
const customers = (await getCollection('customers')).map((e) => ({ id: e.id, ...e.data })).sort((a, b) => a.order - b.order);
const [lead, ...rest] = customers;
---
<Base
  title="NForce.AI | From AI to ROI: AI agents for every channel"
  description="Deploy AI agents on WhatsApp, phone, email and web chat. Watch them work, step in anytime, and see what every agent earned."
>
  <!-- Hero: channels in, one agent, results out -->
  <section class="hero night grain" aria-labelledby="hero-h">
    <HeroField />
    <div class="hero-reed reeded" aria-hidden="true"></div>
    <Arcs class="hero-arcs" rings={11} />
    <!-- Figma "Hero Updates" (node 4:8): wash layer in screen blend; white fade continues the header -->
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 id="hero-h">From AI to ROI<span class="h1-dot"><span class="sr-only">.</span></span></h1>
        <p class="lede">Agents that answer every lead, ticket and call, and show you what they earned.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/demo">Book a demo</a>
          <a class="btn btn-ghost" href="#loop">See how it works</a>
        </div>
      </div>
      <div class="hero-art">
        <HeroSignal />
      </div>
    </div>
  </section>

  <!-- Proof: numbers as heroes -->
  <section class="section day grain proof" aria-labelledby="proof-h">
    <div class="wrap">
      <h2 id="proof-h" class="proof-h">Every agent is measured in revenue and cost, not message volume</h2>
      <div class="proof-lead" data-count={lead.value}>
        <p class="giant num" aria-hidden="true">{lead.prefix}<span class="n">{lead.value}</span>{lead.suffix}</p>
        <p class="giant-cap"><span class="sr-only">{lead.prefix}{lead.value}{lead.suffix} </span>{lead.label}<br /><span>{lead.company}</span></p>
      </div>
      <ul class="proof-rest">
        {rest.map((c) => (
          <li data-count={c.value}>
            <p class="pr-n num" aria-hidden="true">{c.prefix}<span class="n">{c.value}</span>{c.suffix}</p>
            <p class="pr-l"><span class="sr-only">{c.prefix}{c.value}{c.suffix} </span>{c.label}</p>
            <p class="pr-c">{c.company}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Orbit loop -->
  <section id="loop" class="night grain loop" aria-labelledby="loop-h">
    <Arcs class="loop-arcs" rings={6} />
    <div class="wrap loop-intro">
      <h2 id="loop-h">One loop. Deploy, operate, measure, optimize</h2>
      <p class="lede">Each turn of the loop makes your agents faster and cheaper to run. Scroll to turn it.</p>
    </div>
    <OrbitLoop client:visible stops={stops} />
  </section>

  <!-- Speed to lead -->
  <section class="section day grain race-sec" aria-labelledby="race-h">
    <div class="wrap">
      <div class="race-head">
        <div>
          <h2 id="race-h">Your team takes days. We take 30 seconds</h2>
        </div>
        <p class="lede">The average rep replies to a new lead in 47 hours. Start the race and watch an agent book the meeting first.</p>
      </div>
      <SpeedRace client:visible industries={industries} />
      <p class="more"><a href="/use-cases/lead-response">How Lead Response works <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- ROI -->
  <section class="section night grain roi-sec" aria-labelledby="roi-h">
    <div class="beam" aria-hidden="true"></div>
    <div class="wrap">
      <h2 id="roi-h" class="roi-h">What would your team get back?</h2>
      <RoiEstimator client:visible />
    </div>
  </section>

  <!-- Control and ownership -->
  <section class="section day grain own" aria-labelledby="own-h">
    <div class="wrap own-grid">
      <div>
        <h2 id="own-h">Your agents. Your keys. Your call</h2>
        <p class="lede">See every conversation as it happens. Step in on any of them. Keep your models, data and costs in your hands.</p>
        <div class="own-cta">
          <a class="btn btn-primary" href="/demo">Book a demo</a>
          <a class="btn btn-ghost" href="/enterprise">Enterprise and security</a>
        </div>
      </div>
      <dl class="own-list">
        <div><dt>Watch live</dt><dd>Every conversation, on every channel, in one inbox.</dd></div>
        <div><dt>Take over</dt><dd>Step into any conversation. The agent pauses and hands you the context.</dd></div>
        <div><dt>Escalate</dt><dd>Rules route edge cases to the right person, with a summary attached.</dd></div>
        <div><dt>Audit</dt><dd>A log of every reply, takeover and change.</dd></div>
        <div><dt>Bring your own keys</dt><dd>Use your own LLM keys. No per-message fees.</dd></div>
        <div><dt>Deploy anywhere</dt><dd>NForce Cloud or your own infrastructure, with tenant isolation, data residency and SSO.</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; isolation: isolate; overflow: clip; padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 7vw, 6rem); min-height: calc(100svh - 68px); display: grid; align-items: center; }
  .hero-reed { position: absolute; z-index: -1; top: 0; bottom: 0; left: calc(67% - 40px); width: calc(12% + 80px); opacity: .9; mask-image: linear-gradient(180deg, transparent, #000 25%, #000 75%, transparent); }
  /* Background layers stack under the copy and graphic: field (-2), reed and arcs (-1), wash, then fade. */
  /* Stretched to fill the hero exactly as in Figma; a background avoids distorted-<img> audits. */
  .hero-wash { position: absolute; inset: 0; background: url('/hero/hero-wash.webp') center / 100% 100% no-repeat; mix-blend-mode: screen; z-index: -1; pointer-events: none; }
  /* Continues the solid white header into the hero. Eased stops avoid a visible band. */
  .hero-fade {
    position: absolute; left: 0; right: 0; top: 0; height: clamp(56px, 6.5vw, 104px); z-index: -1; pointer-events: none;
    background: linear-gradient(180deg,
      rgb(255 255 255 / 1) 0%, rgb(255 255 255 / .9) 10%, rgb(255 255 255 / .74) 22%,
      rgb(255 255 255 / .55) 35%, rgb(255 255 255 / .36) 50%, rgb(255 255 255 / .2) 65%,
      var(--panel-night) 80%, rgb(255 255 255 / .025) 92%, rgb(255 255 255 / 0) 100%);
  }
  :global(.hero-arcs) { position: absolute; z-index: -1; width: 1400px; right: -520px; top: 50%; transform: translateY(-50%); opacity: .22; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .hero h1 { font-size: clamp(3rem, 1.5rem + 5.6vw, 6.25rem); line-height: 1; }
  /* Round period: Sora's default full stop is square */
  .h1-dot { display: inline-block; width: .16em; height: .16em; margin-left: .05em; border-radius: 50%; background: currentColor; vertical-align: baseline; }
  .hero .lede { margin-top: 1.5rem; color: var(--c-tint); font-size: clamp(1.125rem, 1.02rem + .45vw, 1.375rem); line-height: 1.5; }
  .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2rem; }
  @media (max-width: 1040px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { max-width: 560px; margin: 0 auto; width: 100%; }
    .hero-reed { left: calc(70% - 40px); width: calc(24% + 80px); }
  }

  /* Proof */
  .proof-h { max-width: 20ch; font-size: var(--fs-2xl); }
  .proof-lead { position: relative; margin-top: clamp(1rem, 3vw, 2rem); display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 1rem; }
  .giant {
    font-size: var(--fs-display); line-height: .82; color: var(--c-primary);
    background: linear-gradient(180deg, #452FF4 0%, #2F3BFF 60%, rgb(69 47 244 / .5) 100%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    margin-left: -.06em;
  }
  .giant-cap { font-size: var(--fs-lg); color: var(--c-heading); font-weight: 400; text-align: right; padding-bottom: 1.25rem; }
  .giant-cap span { color: var(--c-body); font-weight: 300; font-size: var(--fs-sm); }
  .proof-rest { list-style: none; margin: clamp(2rem, 5vw, 4rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 3rem; }
  .pr-n { font-size: var(--fs-3xl); color: var(--c-heading); line-height: 1; }
  .pr-l { color: var(--c-heading); font-weight: 400; margin-top: .6rem; }
  .pr-c { font-size: var(--fs-sm); }
  @media (max-width: 760px) {
    .proof-lead { grid-template-columns: 1fr; }
    .giant-cap { text-align: left; padding: 0; }
    .proof-rest { grid-template-columns: 1fr; }
  }

  /* Loop */
  .loop { position: relative; isolation: isolate; overflow: clip; padding-top: clamp(5rem, 10vw, 8rem); }
  :global(.loop-arcs) { position: absolute; z-index: -1; width: 900px; right: -300px; top: -200px; opacity: .45; }
  .loop-intro { max-width: var(--max); }
  .loop-intro h2 { max-width: 16ch; }
  .loop-intro .lede { margin-top: 1.25rem; color: var(--c-tint); }

  /* Race */
  .race-head { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem 4rem; align-items: end; margin-bottom: 2.5rem; }
  .race-head h2 { max-width: 14ch; }
  .more { margin-top: 2rem; }
  @media (max-width: 860px) { .race-head { grid-template-columns: 1fr; } }

  /* ROI */
  .roi-sec .beam { position: absolute; z-index: -1; top: 0; bottom: 0; left: 72%; width: 180px; background: radial-gradient(50% 50% at 50% 40%, rgb(185 179 255 / .45), transparent 70%); filter: blur(30px); }
  .roi-h { margin-bottom: 2.5rem; max-width: 18ch; }

  /* Ownership */
  .own-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .own-grid h2 { max-width: 12ch; }
  .own-grid .lede { margin-top: 1.25rem; }
  .own-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2rem; }
  .own-list { margin: 0; display: grid; gap: 1.5rem; }
  .own-list div { display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; }
  .own-list dt { color: var(--c-heading); font-weight: 600; }
  .own-list dd { margin: 0; }
  @media (max-width: 860px) { .own-grid { grid-template-columns: 1fr; } .own-list div { grid-template-columns: 1fr; gap: .25rem; } }
</style>
