---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import UiCard from '../../components/UiCard.astro';
import StatGrid from '../../components/StatGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { channelName } from '../../components/islands/Icons';

export async function getStaticPaths() {
  const all = (await getCollection('useCases')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
interface Props { entry: CollectionEntry<'useCases'>; all: CollectionEntry<'useCases'>[] }
const { entry, all } = Astro.props;
const d = entry.data;
const others = [
  { name: 'Lead Response', href: '/use-cases/lead-response' },
  ...all.filter((e) => e.id !== entry.id).map((e) => ({ name: e.data.name, href: `/use-cases/${e.id}` })),
];
---
<Base title={d.metaTitle} description={d.metaDescription}>
  <PageHero title={d.title} lede={d.lede} secondary={{ label: 'See pricing', href: '/pricing' }}>
    <UiCard
      title={`${channelName[d.sample.channel]} · ${d.sample.contact}, ${d.sample.company}`}
      kind="chat"
      items={d.sample.lines}
      note={`Agent ${d.sample.agent} · ${d.sample.outcome}`}
    />
  </PageHero>

  <section class="section day grain" aria-labelledby="problem-h">
    <div class="wrap">
      <div class="corners"><p class="label">The problem</p><p class="label">{d.name}</p></div>
      <div class="problem">
        <h2 id="problem-h">{d.problem.title}</h2>
        <p class="lede">{d.problem.body}</p>
      </div>
      <StatGrid stats={d.problem.stats} />
    </div>
  </section>

  <section class="section night grain" aria-labelledby="features-h">
    <div class="wrap">
      <h2 id="features-h" class="feat-h">{d.features.title}</h2>
      <ol class="feat">
        {d.features.items.map((f, i) => (
          <li>
            <span class="feat-n num">0{i + 1}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section day grain" aria-labelledby="impact-h">
    <div class="wrap">
      <h2 id="impact-h" class="impact-h">{d.impact.title}</h2>
      <StatGrid stats={d.impact.stats} size="xl" />
      <nav class="more" aria-label="More use cases">
        <p class="label">More use cases</p>
        <ul>{others.map((o) => <li><a href={o.href}>{o.name} <span aria-hidden="true">→</span></a></li>)}</ul>
      </nav>
    </div>
  </section>

  <CtaBand tone="night" title={`See an agent handle your ${d.name.toLowerCase()} work.`} />
</Base>

<style>
  .corners { display: flex; justify-content: space-between; margin-bottom: 2.5rem; }
  .problem { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2rem 4rem; align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .problem h2 { max-width: 18ch; }
  .feat-h { max-width: 18ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .feat { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 1.5rem; }
  .feat li { position: relative; }
  .feat-n { display: block; font-size: var(--fs-xl); color: #B9B3FF; margin-bottom: 1rem; }
  .feat h3 { margin-bottom: .5rem; }
  .feat p { color: var(--c-tint); }
  .impact-h { max-width: 18ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .more { margin-top: clamp(3rem, 6vw, 5rem); display: flex; flex-wrap: wrap; align-items: baseline; gap: 1rem 2rem; }
  .more ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; }
  .more a { font-weight: 400; }
  @media (max-width: 960px) { .problem { grid-template-columns: 1fr; } .feat { grid-template-columns: 1fr 1fr; gap: 2rem 1.5rem; } }
  @media (max-width: 560px) { .feat { grid-template-columns: 1fr; } }
</style>
