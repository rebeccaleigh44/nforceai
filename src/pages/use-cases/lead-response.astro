---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Arcs from '../../components/Arcs.astro';
import CtaBand from '../../components/CtaBand.astro';
import SpeedRace from '../../components/islands/SpeedRace';

const industries = (await getCollection('industries')).map((e) => ({ id: e.id, ...e.data }));
const nester = (await getEntry('customers', 'nester'))!.data;
const steps = [
  { n: '1', h: 'A lead arrives', p: 'From a form, an ad, WhatsApp, a call or web chat. The agent sees it the moment it lands.' },
  { n: '2', h: 'The agent replies in seconds', p: 'It answers questions, asks the qualifying ones you set, and keeps the conversation moving.' },
  { n: '3', h: 'The meeting is booked', p: 'Straight onto the right rep’s calendar, with a summary of what the lead said.' },
  { n: '4', h: 'Your rep takes it from there', p: 'Or steps in earlier. Any conversation can be taken over at any moment.' },
];
---
<Base
  title="Lead Response | NForce.AI"
  description="Your team takes days. We take 30 seconds. NForce agents reply to every new lead on every channel, qualify it, and book the meeting."
>
  <section class="section night grain lr-hero" aria-labelledby="lr-h">
    <Arcs class="lr-arcs" rings={10} />
    <div class="lr-beam" aria-hidden="true"></div>
    <div class="wrap">
      <div class="lr-top">
        <div>
          <h1 id="lr-h">Your team takes days. We take 30 seconds</h1>
        </div>
        <div class="lr-poster" aria-hidden="true">
          <span class="num p-a">47h</span>
          <span class="num p-b">30s</span>
        </div>
      </div>
      <p class="lede lr-lede">The average first reply to a new lead takes 47 hours. NForce agents answer in under 30 seconds, on every channel, around the clock. Pick your industry and start the race.</p>
      <div class="lr-race"><SpeedRace client:visible industries={industries} showSwitcher /></div>
    </div>
  </section>

  <section class="section day grain" aria-labelledby="how-h">
    <div class="wrap">
      <div class="corners"><p class="label">How it works</p><p class="label">From first message to booked</p></div>
      <h2 id="how-h" class="how-h">Every lead gets an answer while it still wants one</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li><span class="num s-n">{s.n}</span><h3>{s.h}</h3><p>{s.p}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section night grain" aria-labelledby="ind-h">
    <div class="wrap ind-grid">
      <div>
        <h2 id="ind-h">Wherever a lead costs money, it gets an answer</h2>
      </div>
      <ul class="ind-list">
        {industries.map((i) => (
          <li><span class="ind-n">{i.name}</span><span class="ind-b">{i.booked.split(':')[0]}</span></li>
        ))}
      </ul>
    </div>
    <div class="wrap proof-band" data-count={nester.value}>
      <p class="pb-n num" aria-hidden="true">{nester.prefix}<span class="n">{nester.value}</span>{nester.suffix}</p>
      <p class="pb-l"><span class="sr-only">{nester.prefix}{nester.value}{nester.suffix} </span>{nester.label} at {nester.company}</p>
      <p class="pb-m"><span class="num">10,000+</span> leads handled by NForce agents</p>
    </div>
  </section>

  <CtaBand title="Answer your next lead in 30 seconds" />
</Base>

<style>
  .lr-hero { padding-top: clamp(3rem, 7vw, 6rem); }
  :global(.lr-arcs) { position: absolute; z-index: -1; width: 1200px; right: -460px; top: -320px; opacity: .5; }
  .lr-beam { position: absolute; z-index: -1; top: 0; height: 70%; left: 64%; width: 2px; background: linear-gradient(180deg, transparent, rgb(217 214 255 / .7), transparent); box-shadow: 0 0 60px 30px rgb(69 47 244 / .35); }
  .lr-top { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: end; }
  .lr-top h1 { font-size: clamp(2.75rem, 1.4rem + 4.6vw, 5.5rem); max-width: 13ch; }
  .lr-poster { position: relative; height: 100%; min-height: 220px; }
  .lr-poster .num { position: absolute; line-height: .8; }
  .p-a { font-size: clamp(5rem, 2rem + 10vw, 12rem); color: rgb(255 255 255 / .1); right: 0; top: 0; }
  .p-b { font-size: clamp(3.5rem, 1.5rem + 6vw, 7.5rem); color: var(--c-white); right: 8%; bottom: 0; }
  .lr-lede { margin: 2rem 0 3rem; color: var(--c-tint); max-width: 52ch; }

  .corners { display: flex; justify-content: space-between; margin-bottom: 2.5rem; }
  .how-h { max-width: 18ch; margin-bottom: 3rem; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .steps li { padding: 1.5rem 1.5rem 0 0; border-top: 1px solid var(--line-day); position: relative; }
  .steps li::before { content: ""; position: absolute; top: -4px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--c-primary); }
  .s-n { display: block; font-size: var(--fs-xl); color: var(--c-primary); margin-bottom: 1rem; }
  .steps h3 { margin-bottom: .5rem; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; gap: 2rem 0; } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } .lr-top { grid-template-columns: 1fr; } .lr-poster { min-height: 140px; } }

  .ind-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: start; }
  .ind-grid h2 { max-width: 14ch; }
  .ind-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .ind-list li { display: flex; justify-content: space-between; gap: 1rem; }
  .ind-n { color: var(--c-white); font-size: var(--fs-lg); font-weight: 400; }
  .ind-b { color: var(--c-lilac); font-size: var(--fs-sm); }
  .proof-band { display: grid; grid-template-columns: auto 1fr auto; align-items: end; gap: 2rem; margin-top: clamp(4rem, 8vw, 7rem); }
  .pb-n { font-size: clamp(5rem, 2rem + 10vw, 12rem); line-height: .8; color: var(--c-white); }
  .pb-l { color: var(--c-white); font-size: var(--fs-lg); padding-bottom: .5rem; }
  .pb-m { color: var(--c-lilac); text-align: right; padding-bottom: .5rem; }
  .pb-m .num { color: var(--c-white); font-size: var(--fs-xl); display: block; }
  @media (max-width: 860px) { .ind-grid, .proof-band { grid-template-columns: 1fr; } .pb-m { text-align: left; } }
</style>
